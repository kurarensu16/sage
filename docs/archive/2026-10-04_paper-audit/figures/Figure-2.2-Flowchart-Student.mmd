%% ===== Figure 2.2 — Proposed System Flowchart: Student Portal (CORRECTED) =====

  SEL{"Select module"}
  OUT(["<b>Log out / End</b>"]):::accent

  subgraph LOGIN["<b>Authentication</b>"]
    direction LR
    START(["<b>Start</b>"]):::accent --> CRED[/"Enter credentials"/] --> VALID{"Valid credentials?"}
    VALID -- "No" --> ERR["Show login error"]
    ERR -.-> CRED
    VALID -- "Yes" --> FIRST{"First login?"}
    FIRST -- "Yes" --> CHG["Change temporary password"] --> DASH["<b>Dashboard</b>"]:::accent
    FIRST -- "No" --> DASH
  end

  LOGIN --> SEL
  SEL -- "Log out" --> OUT

  SEL -- "My Grades" --> GM
  SEL -- "Attendance" --> TM
  SEL -- "Support" --> PM
  SEL -- "Consult" --> CM
  SEL -- "Account" --> NM

  subgraph GM["<b>My Grades Module</b>"]
    direction TB
    G1["My Subjects:<br/>select a subject"] --> GB["Score Breakdown:<br/>activity title,<br/>description, score"]
    G1 --> GQ{"Milestone<br/>officially posted?"}
    GQ -- "Not yet" --> GH["Milestone hidden<br/>from student"]
    GQ -- "Yes" --> GR["Grade Report:<br/>MR, TFR, SG, GWA"]
  end

  subgraph TM["<b>Attendance and Warnings Module</b>"]
    direction TB
    T1["View per-subject<br/>attendance record"] --> TQ{"4 or more<br/>absences?"}
    TQ -- "No" --> TN["No warning shown"]
    TQ -- "Yes" --> TY["Show FDA<br/>warning badge"]
  end

  subgraph PM["<b>Academic Support Module</b>"]
    direction TB
    P1["Advisories and<br/>Study Plans inbox"] --> PQ{"Faculty-approved?"}
    PQ -- "No" --> PN["&quot;Pending Instructor<br/>Review&quot; lock banner"]
    PQ -- "Yes" --> PY["View catch-up plan<br/>and mark tasks done"] --> PV["Task moves to pending<br/>faculty verification"]
    P2["AI Academic Advisor"] --> AQ{"AI service<br/>available?"}
    AQ -- "No" --> AN["Local fallback<br/>recommendation"]
    AQ -- "Yes" --> AY["Topic-grounded diagnostics<br/>and what-if GWA simulator"]
  end

  subgraph CM["<b>Consultations Module</b>"]
    direction TB
    C1["Request consultation:<br/>concern and schedule"] --> C2["View instructor<br/>response and status"]
  end

  subgraph NM["<b>Account Module</b>"]
    direction TB
    N1["My Profile, Change Password,<br/>Notification Settings"]
  end


  classDef accent fill:#1E3A8A,stroke:#1E3A8A,color:#FFFFFF;

