%% ===== Figure 2.9 — Level 1 DFD: Faculty Portal (CORRECTED) =====
%% Layout: External entity (left) -> Process (middle) -> Data stores (right)

  %% ---------- 1.0 ----------
  F1["Faculty"] <-- "credentials / access session" --> P1(("1.0<br/>Authenticate<br/>User"))
  P1 <-- "account record" --> D1@{ shape: lin-rect, label: "D1&nbsp; users" }

  %% ---------- 2.0 ----------
  F2["Faculty"] <-- "class, risk and<br/>consultation summary" --> P2(("2.0<br/>Load<br/>Dashboard"))
  P2 <-- "handled sections" --> D7b@{ shape: lin-rect, label: "D7&nbsp; class_records" }
  P2 <-- "risk distribution" --> D16b@{ shape: lin-rect, label: "D16&nbsp; student_risk_evaluations" }
  P2 <-- "pending requests" --> D23b@{ shape: lin-rect, label: "D23&nbsp; student_consultation_requests" }

  %% ---------- 3.0 ----------
  F3["Faculty"] <-- "activity metadata and raw scores /<br/>locked and active columns" --> P3(("3.0<br/>Log Class<br/>Scores"))
  P3 <-- "title, description, max score" --> D10c@{ shape: lin-rect, label: "D10&nbsp; class_activities" }
  P3 <-- "per-student scores" --> D11c@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }

  %% ---------- 4.0 ----------
  F4["Faculty"] <-- "MR / TFR / SG preview /<br/>post command" --> P4(("4.0<br/>Preview and<br/>Post Grades"))
  P4 <-- "COG template weights" --> D6d@{ shape: lin-rect, label: "D6&nbsp; grade_computations" }
  P4 <-- "official milestones" --> D12d@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }

  %% ---------- 5.0 ----------
  F5["Faculty"] <-- "correction reason / request status" --> P5(("5.0<br/>Request Grade<br/>Correction"))
  P5 <-- "reopen request" --> D13e@{ shape: lin-rect, label: "D13&nbsp; unlock_requests" }
  P5 <-- "remark change request" --> D14e@{ shape: lin-rect, label: "D14&nbsp; remark_override_requests" }

  %% ---------- 6.0 ----------
  F6["Faculty"] <-- "risk-sorted roster and<br/>factor breakdown" --> P6(("6.0<br/>Compute At-Risk<br/>Roster"))
  P6 <-- "missing work" --> D11f@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }
  P6 <-- "running GWA" --> D12f@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }
  P6 <-- "absence counts" --> D15f@{ shape: lin-rect, label: "D15&nbsp; attendance_records" }

  %% ---------- 7.0 ----------
  F7["Faculty"] <-- "observations, advising plan, referral /<br/>baseline snapshot, task status" --> P7(("7.0<br/>HITL Evaluate<br/>Student"))
  P7 <-- "risk score, advising plan,<br/>snapshots, Dean referral" --> D16g@{ shape: lin-rect, label: "D16&nbsp; student_risk_evaluations" }
  P7 -- "private observations" --> D17g@{ shape: lin-rect, label: "D17&nbsp; student_risk_private_notes" }
  P7 -- "audit entry" --> D25g@{ shape: lin-rect, label: "D25&nbsp; activity_logs" }

  %% ---------- 8.0 ----------
  F8["Faculty"] <-- "attendance entries / FDA warning badges" --> P8(("8.0<br/>Monitor<br/>Attendance"))
  P8 <-- "Present / Late / Absent" --> D15h@{ shape: lin-rect, label: "D15&nbsp; attendance_records" }

  %% ---------- 9.0 ----------
  F9["Faculty"] <-- "consultation requests /<br/>response, resolution notes" --> P9(("9.0<br/>Handle<br/>Consultations"))
  P9 <-- "request and status" --> D23i@{ shape: lin-rect, label: "D23&nbsp; student_consultation_requests" }
