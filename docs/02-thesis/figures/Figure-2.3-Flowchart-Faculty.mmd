flowchart TB
%% ===== Figure 2.3 — Proposed System Flowchart: Faculty Portal (updated 2026-10-10) =====
%% Updated 2026-10-30:
%%   - Create Classrooms and Enrollment Requests are gone. Classes are provisioned by the
%%     Registrar or Dean through Faculty Loading, and an irregular student is added straight
%%     onto the roster, so there is no code and no approval queue here.
%%   - the consultation REQUEST flow is gone; it is a grade consultation log now
%%   + Grade Change Requests: the instructor's two steps in the dispute chain
%% UI labels (Preview & Post Grades, My Class Records, Evaluate Students, Performance Reports);
%% SG correction proposal and matching repost; task verify/return; one-time follow-up.
%% Revised 2026-10-10 (evening): follow-up after reported tasks are reviewed; re-evaluation in a later
%% term; late-enrollee zeros after approval; roster update notices.

  SEL{"Select module"}
  OUT(["<b>Log out / End</b>"]):::accent

  subgraph LOGIN["<b>Authentication</b>"]
    direction LR
    START(["<b>Start</b>"]):::accent --> CRED[/"Enter credentials"/] --> VALID{"Valid credentials?"}
    VALID -- "No" --> ERR["Show login error"]
    ERR -.-> CRED
    VALID -- "Yes" --> FIRST{"First login?"}
    FIRST -- "Yes" --> CHG["Change temporary password"] --> DASH["<b>Dashboard</b>"]:::accent
    FIRST -- "No" --> DASH
  end

  LOGIN --> SEL
  SEL -- "Log out" --> OUT

  SEL -- "Grades" --> GM
  SEL -- "Classes" --> KM
  SEL -- "Student Risk" --> RM
  SEL -- "Attendance" --> TM
  SEL -- "Reports" --> PM
  SEL -- "Grades and Disputes" --> CM
  SEL -- "Account" --> NM

  subgraph ROW1[" "]
    direction LR
    subgraph GM["<b>Grades Module</b>"]
      direction TB
      G1["Log Class Scores"] --> GQ{"Metadata<br/>set?"}
      GQ -- "No" --> GL["Column locked"]
      GQ -- "Yes" --> GE["Enter raw scores"]
      GE --> GP["Preview & Post Grades:<br/>COG applied, post milestone"]
      GP --> GC{"SG needs<br/>correction?"}
      GC -- "Yes" --> GS["Submit SG correction<br/>proposal to Dean"]
      GS --> GA{"Dean<br/>approved?"}
      GA -- "Yes" --> GR["Repost the<br/>approved SG"]
      GA -- "No" --> GN["SG stays locked"]
    end
    subgraph KM["<b>Classes Module</b>"]
      direction TB
      K1["My Class Records:<br/>rosters and<br/>irregular-student labels"]
      K4["Roster update notices:<br/>students added by the<br/>Registrar or Dean"] --> KL{"Milestone already<br/>posted?"}
      KL -- "Yes" --> KZ["Enter 0 for missing<br/>posted-term work;<br/>replace after make-up"]
      K1 ~~~ K4
    end
    subgraph RM["<b>Student Risk Module</b>"]
      direction TB
      R1["Evaluate Students:<br/>risk-sorted roster"] --> R2["Academic Intervention Form:<br/>factor breakdown, notes,<br/>1-5 catch-up tasks (manual or AI)"]
      R2 --> R3["Publish plan;<br/>baseline frozen;<br/>optional Dean referral"]
      R3 --> RS["Evaluated Students:<br/>student acknowledges<br/>and reports tasks"]
      RS --> RA{"Verify?"}
      RA -- "Yes" --> RV["Task verified"]
      RA -- "No" --> RR["Returned<br/>with a note"]
      RV --> RT{"All reported<br/>tasks reviewed?"}
      RT -- "No" --> RW["Review the remaining<br/>reported tasks first"]
      RT -- "Yes" --> RF["After next MR / TFR / SG:<br/>record one-time follow-up;<br/>plan closed"]
      RF --> RN{"Still needs<br/>support?"}
      RN -- "Yes" --> RE["Evaluate again in a<br/>later grading term<br/>(new baseline)"]
    end
  end

  subgraph ROW2[" "]
    direction LR
    subgraph TM["<b>Attendance Module</b>"]
      direction TB
      T1["Attendance Monitoring"] --> TQ{"4 or more<br/>absences?"}
      TQ -- "No" --> TN["No warning"]
      TQ -- "Yes" --> TY["FDA warning badge<br/>(advisory only)"] --> TD["Instructor decides<br/>FDA remark"]
    end
    subgraph PM["<b>Performance Reports Module</b>"]
      direction TB
      P1["Class Performance:<br/>score distribution,<br/>component averages"]
      P2["Performance Comparison:<br/>across sections and<br/>grading periods"]
      P1 --> PX["Export or print"]
      P2 --> PX
    end
    subgraph CM["<b>Grades Module (disputes)</b>"]
      direction TB
      C1["Grade Consultation Log:<br/>consultations raised in the<br/>window after a posting"]
      C3["Grade Change Requests"] --> CQ{"Applicable?"}
      CQ -- "No" --> CR["Rejected, reason recorded"]
      CQ -- "Yes" --> CF["Forwarded to the Dean"]
      CF --> CD{"Authorized?"}
      CD -- "Yes" --> CA["Apply the correction.<br/>MR and TFR use a dedicated<br/>editor; SG uses the one-use<br/>full-row workflow"]
      C1 ~~~ C3
    end
    subgraph NM["<b>Account Module</b>"]
      direction TB
      N1["My Profile: photo,<br/>contact number"]
      N2["Change Password"]
      N3["Notification Preferences"]
      N1 ~~~ N2 ~~~ N3
    end
  end

  ROW1 ~~~ ROW2

  classDef accent fill:#14532D,stroke:#14532D,color:#FFFFFF;

  style ROW1 fill:#FFFFFF,stroke:#FFFFFF
  style ROW2 fill:#FFFFFF,stroke:#FFFFFF
