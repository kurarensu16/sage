%% ===== Figure 2.8 — Level 1 DFD: Student Portal (updated 2026-10-30) =====
%% Each process corresponds 1:1 with a module in Figure 2.12 (VTOC) and the Scope and Delimitation.
%% Changes against the 2026-10-14 version:
%%   3.0 My Grades      - class_room_join_codes and class_join_requests removed; both tables were
%%                        dropped and irregular enrolment is now done by the Registrar or Dean
%%   5.0 Academic Support - now covers Academic Insights and AI Study Advising as well as the
%%                        advisories inbox; reads faculty learning resources, writes tutor plans,
%%                        practice sets and the metered call log
%%   6.0 Grades and Consultation - the consultation REQUEST flow is gone. What remains is the
%%                        read-only consultation history plus the grade change request chain
%% The AI provider node is left as the paper documents it, by the owner's decision.
%% Layout: External entity (left) -> Process (middle) -> Data stores (right)

%% COLUMN B of 2. Split from Figure-2.8-DFD-Student.mmd so the figure fits a page; compose with
%% compose_columns.py. Edit the halves, not a merged copy.
  %% ---------- 5.0 ----------
  S5["Student"] <-- "question / topic diagnostics,<br/>areas for attention, honors blockers,<br/>study plan, practice attempt / published plans,<br/>task decisions / acknowledgment, task reports" --> P5(("5.0<br/>Academic<br/>Support"))
  P5 <-- "activity metadata" --> D10e@{ shape: lin-rect, label: "D10&nbsp; class_activities" }
  P5 <-- "faculty learning material" --> D37e@{ shape: lin-rect, label: "D37&nbsp; activity_resources" }
  P5 <-- "posted milestones" --> D12e@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }
  P5 <-- "recorded scores" --> D11e@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }
  P5 -- "advisory log" --> D20e@{ shape: lin-rect, label: "D20&nbsp; student_academic_insights" }
  P5 <-- "active plan, archived on rollover" --> D38e@{ shape: lin-rect, label: "D38&nbsp; student_tutor_plans" }
  P5 -- "generated set (answers withheld)" --> D39e@{ shape: lin-rect, label: "D39&nbsp; student_tutor_practice_sets" }
  P5 <-- "submitted attempt / score" --> D40e@{ shape: lin-rect, label: "D40&nbsp; student_tutor_practice_attempts" }
  P5 -- "metered call, tokens, model" --> D41e@{ shape: lin-rect, label: "D41&nbsp; student_tutor_log" }
  P5 <-- "curated further reading" --> D42e@{ shape: lin-rect, label: "D42&nbsp; search_destinations" }
  P5 <-- "published plan, acknowledgment,<br/>reported and verified tasks" --> D16e@{ shape: lin-rect, label: "D16&nbsp; student_risk_evaluations" }
  P5 <-- "grounded prompt / JSON diagnostics" --> AIP["AI Model Provider<br/>(Gemini 2.5 Flash<br/>via OpenRouter)"]

  %% ---------- 6.0 ----------
  S6["Student"] <-- "consultation history / dispute,<br/>evidence files / request status" --> P6(("6.0<br/>Grades and<br/>Consultation"))
  P6 <-- "logged consultations" --> D43f@{ shape: lin-rect, label: "D43&nbsp; grade_consultation_notes" }
  P6 <-- "window opened after posting" --> D44f@{ shape: lin-rect, label: "D44&nbsp; grade_consultation_windows" }
  P6 <-- "grade change request,<br/>decision at each step" --> D45f@{ shape: lin-rect, label: "D45&nbsp; remark_override_requests" }
  P6 -- "one to three required files" --> D46f@{ shape: lin-rect, label: "D46&nbsp; grade_change_evidence<br/>(private storage)" }

  %% ---------- 7.0 ----------
  S7["Student"] <-- "photo, contact number, guardian,<br/>password, alert choices / profile" --> P7(("7.0<br/>Account"))
  P7 <-- "contact number, photo reference" --> D1g@{ shape: lin-rect, label: "D1&nbsp; users" }
  P7 <-- "profile photo file" --> D30g@{ shape: lin-rect, label: "D30&nbsp; avatars (private storage)" }
  P7 <-- "primary guardian contact" --> D28g@{ shape: lin-rect, label: "D28&nbsp; guardians" }
  P7 <-- "device and email choices" --> D29g@{ shape: lin-rect, label: "D29&nbsp; notification_preferences" }
