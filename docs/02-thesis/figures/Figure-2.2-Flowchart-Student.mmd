%% ===== Figure 2.2 — Proposed System Flowchart: Student Portal (updated 2026-10-10) =====
%% Plans appear only after publication and must be acknowledged; faculty verify or return
%% reported tasks; Account shows photo/contact/guardian.
%% Updated 2026-10-30:
%%   - joining a class by code is gone; the Registrar or Dean adds an irregular student
%%     straight onto the roster, so there is no request and no waiting state
%%   - the consultation REQUEST flow is gone; what remains is a read-only history plus the
%%     grade change request chain, which is where a disputed grade now goes
%%   + Academic Insights, a page of its own beside AI Study Advising
%%   AI Study Tutor renamed AI Study Advising
%% Revised 2026-10-11: unposted milestones show a tentative running GWA (posted milestones replace it);
%% see docs/02-thesis/decisions/STUDENT_RUNNING_GWA_2026-10-11.md.

  SEL{"Select module"}
  OUT(["<b>Log out / End</b>"]):::accent

  subgraph LOGIN["<b>Authentication</b>"]
    direction LR
    START(["<b>Start</b>"]):::accent --> CRED[/"Enter credentials"/] --> VALID{"Valid credentials?"}
    VALID -- "No" --> ERR["Show login error"]
    ERR -.-> CRED
    VALID -- "Yes" --> FIRST{"First login?"}
    FIRST -- "Yes" --> CHG["Change temporary password<br/>(8+ characters, upper and<br/>lower case, number, symbol)"] --> DASH["<b>Dashboard</b>"]:::accent
    FIRST -- "No" --> DASH
  end

  LOGIN --> SEL
  SEL -- "Log out" --> OUT

  SEL -- "My Grades" --> GM
  SEL -- "Attendance" --> TM
  SEL -- "Support" --> PM
  SEL -- "Grades and Consultation" --> CM
  SEL -- "Account" --> NM

  subgraph GM["<b>My Grades Module</b>"]
    direction TB
    G1["My Subjects:<br/>select a subject"] --> GB["Score Breakdown:<br/>activity title,<br/>description, score"]
    G1 --> GQ{"Milestone<br/>officially posted?"}
    GQ -- "Not yet" --> GH["Show running GWA<br/>from recorded scores<br/>(labeled Tentative)"]
    GQ -- "Yes" --> GR["Grade Report:<br/>posted MR, TFR, SG, GWA"]
  end

  subgraph TM["<b>Attendance and Warnings Module</b>"]
    direction TB
    T1["View per-subject<br/>attendance record"] --> TQ{"4 or more<br/>absences?"}
    TQ -- "No" --> TN["No warning shown"]
    TQ -- "Yes" --> TY["Show FDA<br/>warning badge"]
  end

  subgraph PM["<b>Academic Support Module</b>"]
    direction TB
    P1["Advisories and<br/>Study Plans inbox"] --> PQ{"Published by<br/>instructor?"}
    PQ -- "No" --> PN["Plan not shown<br/>to student"]
    PQ -- "Yes" --> PA{"Plan<br/>acknowledged?"}
    PA -- "No" --> PK["Acknowledge plan<br/>(time recorded)"]
    PK --> PY
    PA -- "Yes" --> PY["Report task done"] --> PV{"Instructor<br/>decision"}
    PV -- "Verified" --> PVV["Task locked<br/>as verified"]
    PV -- "Returned" --> PR["Read instructor note,<br/>redo and report again"]
    P2["Academic Insights:<br/>areas for attention,<br/>honors blockers, Ask ASPIRE"]
    P3["AI Study Advising"] --> AQ{"AI service<br/>available?"}
    AQ -- "No" --> AN["Local fallback<br/>recommendation"]
    AQ -- "Yes" --> AY["Topic-grounded diagnostics,<br/>one active study plan per<br/>subject, practice set"]
    AY --> AP{"Practice<br/>submitted?"}
    AP -- "No" --> AW["Answers withheld"]
    AP -- "Yes" --> AS["Answers and explanation<br/>released"]
  end

  subgraph CM["<b>Grades and Consultation Module</b>"]
    direction TB
    C1["Consultation History:<br/>consultations logged in the<br/>window opened after a posting"]
    C2["Dispute a posted result"] --> CQ{"Within the<br/>dispute window?"}
    CQ -- "No" --> CN["Request goes to the Registrar,<br/>who alone may reopen a<br/>closed term"]
    CQ -- "Yes" --> CE[/"Attach one to three<br/>required evidence files"/]
    CE --> CF["Instructor review"] --> CD["Dean decision"]
    CD --> CA["Instructor applies<br/>the authorized correction"]
    C1 ~~~ C2
  end

  subgraph NM["<b>Account Module</b>"]
    direction TB
    N1["My Profile: photo,<br/>contact number,<br/>guardian contact"]
    N2["Change Password"]
    N3["Notification Preferences:<br/>device and email alerts"]
    N1 ~~~ N2 ~~~ N3
  end


  classDef accent fill:#1E3A8A,stroke:#1E3A8A,color:#FFFFFF;

  GM ~~~ CM
  PM ~~~ NM
