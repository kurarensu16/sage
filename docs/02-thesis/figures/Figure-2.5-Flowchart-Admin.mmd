flowchart TB
%% ===== Proposed System Flowchart: Admin Portal (updated 2026-10-30) =====
%% The admin/registrar role split removed the whole Academic Setup branch and grade override
%% from this portal; both now belong to the Registrar. What replaces them is the system
%% maintenance that was always here but never drawn: service health, storage and AI allowance
%% metering, maintenance windows, and encrypted backups.
%% Admin is now accounts and system maintenance only.
%% CSV/Excel import for users, subjects, and sections; identity fields admin-managed.
%% Revised 2026-10-10 (evening): section assignment and classroom provisioning enroll section
%% students and notify instructors of the count.

  SEL{"Select module"}
  OUT(["<b>Log out / End</b>"]):::accent

  subgraph LOGIN["<b>Authentication</b>"]
    direction LR
    START(["<b>Start</b>"]):::accent --> CRED[/"Enter credentials"/] --> VALID{"Valid credentials?"}
    VALID -- "No" --> ERR["Show login error"]
    ERR -.-> CRED
    VALID -- "Yes" --> FIRST{"First login?"}
    FIRST -- "Yes" --> CHG["Change temporary password"] --> DASH["<b>Dashboard</b>"]:::accent
    FIRST -- "No" --> DASH
  end

  LOGIN --> SEL
  SEL -- "Log out" --> OUT

  SEL -- "User Accounts" --> UM
  SEL -- "Student Account Requests" --> UM2
  SEL -- "System Maintenance" --> YM
  SEL -- "Account" --> NM

  subgraph UM["<b>User Accounts Module</b>"]
    direction TB
    U1["Manage Users (all five roles):<br/>name, email, ID, department,<br/>section are admin-managed"] --> UQ{"Individual or batch?"}
    UQ -- "Batch" --> UB["Import Users (CSV/Excel):<br/>roles and departments<br/>assigned from file"]
    UQ -- "Individual" --> US["Create single account"]
    UB --> UE["Student with a section:<br/>enrolled in its active classes;<br/>instructors notified (count)"]
    US --> UE
  end

  subgraph UM2["<b>User Accounts, continued</b>"]
    direction TB
    U7["Student Account Requests"] --> UQ2{"Approve?"}
    UQ2 -- "No" --> U8["Declined, reason recorded"]
    UQ2 -- "Yes" --> U9["Account created;<br/>Registrar can enrol the student"]
  end

  subgraph YM["<b>System Maintenance Module</b>"]
    direction TB
    Y2["Audit Logs<br/>(immutable ledger)"]
    Y5["System Health:<br/>service availability,<br/>recent errors"]
    Y6["Storage Health:<br/>database capacity,<br/>object storage, AI allowance,<br/>evidence retention"]
    Y7["Maintenance Mode"] --> Y8{"Window active?"}
    Y8 -- "Yes" --> Y9["Non-administrators see<br/>the maintenance screen"]
    Y10["Backup and Restore"] --> Y11["Encrypted backup produced;<br/>there is no plain-text option"]
    Y2 ~~~ Y5 ~~~ Y6 ~~~ Y7
  end

  subgraph NM["<b>Account Module</b>"]
    direction TB
    N1["My Profile: photo,<br/>contact number"]
    N2["Change Password"]
    N3["Notification Preferences"]
    N1 ~~~ N2 ~~~ N3
  end


  classDef accent fill:#C2410C,stroke:#C2410C,color:#FFFFFF;
