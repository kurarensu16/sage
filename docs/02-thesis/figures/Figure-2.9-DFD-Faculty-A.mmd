%% ===== Figure 2.9 — Level 1 DFD: Faculty Portal — column A (processes 1.0–5.0), consolidated 2026-10-14 =====
%% Each process now corresponds 1:1 with a module in Figure 2.12 (VTOC) and the Scope and Delimitation.
%% Log Class Scores / Preview & Post Grades / Request SG Correction merge into 3.0 Grades.
%% Two-column layout (see compose_columns.py).

  %% ---------- 1.0 ----------
  F1["Faculty"] <-- "credentials / access session" --> P1(("1.0<br/>Authenticate<br/>User"))
  P1 <-- "account record" --> D1@{ shape: lin-rect, label: "D1&nbsp; users" }

  %% ---------- 2.0 ----------
  F2["Faculty"] <-- "class, risk and<br/>consultation summary" --> P2(("2.0<br/>Dashboard"))
  P2 <-- "handled sections" --> D7b@{ shape: lin-rect, label: "D7&nbsp; class_records" }
  P2 <-- "risk distribution" --> D16b@{ shape: lin-rect, label: "D16&nbsp; student_risk_evaluations" }
  P2 <-- "pending requests" --> D23b@{ shape: lin-rect, label: "D23&nbsp; student_consultation_requests" }

  %% ---------- 3.0 ----------
  F3["Faculty"] <-- "activity metadata and raw scores /<br/>locked and active columns / MR / TFR / SG<br/>preview / post command / proposed SG,<br/>remark, evidence / request status" --> P3(("3.0<br/>Grades"))
  P3 <-- "title, description, max score" --> D10c@{ shape: lin-rect, label: "D10&nbsp; class_activities" }
  P3 <-- "per-student scores" --> D11c@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }
  P3 <-- "COG template weights" --> D6c@{ shape: lin-rect, label: "D6&nbsp; grade_computations" }
  P3 <-- "official milestones,<br/>matching SG repost" --> D12c@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }
  P3 <-- "correction proposal, decision" --> D14c@{ shape: lin-rect, label: "D14&nbsp; remark_override_requests" }
  P3 -- "applied correction" --> D34c@{ shape: lin-rect, label: "D34&nbsp; grade_correction_history" }

  %% ---------- 4.0 ----------
  F4["Faculty"] <-- "new classrooms, approvals /<br/>class records, join codes,<br/>enrollment requests" --> P4(("4.0<br/>Classes"))
  P4 <-- "classroom instances" --> D7d@{ shape: lin-rect, label: "D7&nbsp; class_records" }
  P4 <-- "join codes" --> D35d@{ shape: lin-rect, label: "D35&nbsp; class_room_join_codes" }
  P4 <-- "join requests, decision" --> D36d@{ shape: lin-rect, label: "D36&nbsp; class_join_requests" }
  P4 -- "approved student" --> D8d@{ shape: lin-rect, label: "D8&nbsp; enrollments" }

  %% ---------- 5.0 ----------
  F5["Faculty"] <-- "risk-sorted roster and factor<br/>breakdown / observations, plan,<br/>referral / baseline, AI task drafts /<br/>acknowledgment, reported tasks /<br/>verify or return, record follow-up" --> P5(("5.0<br/>Student<br/>Risk"))
  P5 <-- "recorded zeros, running GWA" --> D12e@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }
  P5 <-- "recorded scores" --> D11e@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }
  P5 <-- "absence counts" --> D15e@{ shape: lin-rect, label: "D15&nbsp; attendance_records" }
  P5 <-- "risk score, published plan,<br/>frozen baseline, task verification,<br/>follow-up snapshot" --> D16e@{ shape: lin-rect, label: "D16&nbsp; student_risk_evaluations" }
  P5 -- "private observations" --> D17e@{ shape: lin-rect, label: "D17&nbsp; student_risk_private_notes" }
  P5 <-- "unpublished work" --> D33e@{ shape: lin-rect, label: "D33&nbsp; faculty_intervention_working_drafts" }
  P5 <-- "AI task drafts" --> D32e@{ shape: lin-rect, label: "D32&nbsp; faculty_intervention_drafts" }
  P5 -- "Dean referral, reason" --> D31e@{ shape: lin-rect, label: "D31&nbsp; student_evaluation_referrals" }
  P5 -- "audit entry" --> D25e@{ shape: lin-rect, label: "D25&nbsp; activity_logs" }
  P5 <-- "evaluation snapshot / 3 draft tasks" --> AIP["AI Model Provider<br/>(Gemini 2.5 Flash<br/>via OpenRouter)"]
