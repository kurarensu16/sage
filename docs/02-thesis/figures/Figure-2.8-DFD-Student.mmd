%% ===== Figure 2.8 — Level 1 DFD: Student Portal (consolidated to module-level processes, 2026-10-14) =====
%% Each process now corresponds 1:1 with a module in Figure 2.12 (VTOC) and the Scope and Delimitation.
%% Former sub-page-level processes (Grade Report / Score Breakdown / Join Class by Code under My Grades;
%% AI Study Tutor / Advisories & Study Plans under Academic Support) are merged into one bubble per module.
%% Layout: External entity (left) -> Process (middle) -> Data stores (right)

  %% ---------- 1.0 ----------
  S1["Student"] <-- "credentials / access session" --> P1(("1.0<br/>Authenticate<br/>User"))
  P1 <-- "account record" --> D1@{ shape: lin-rect, label: "D1&nbsp; users" }

  %% ---------- 2.0 ----------
  S2["Student"] <-- "running / posted GWA,<br/>standing badge" --> P2(("2.0<br/>Dashboard"))
  P2 <-- "enrolled subjects" --> D8b@{ shape: lin-rect, label: "D8&nbsp; enrollments" }
  P2 <-- "posted grades" --> D12b@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }
  P2 <-- "recorded scores" --> D11b@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }
  P2 <-- "latest risk score" --> D16b@{ shape: lin-rect, label: "D16&nbsp; student_risk_evaluations" }

  %% ---------- 3.0 ----------
  S3["Student"] <-- "enrolled subjects, posted milestones,<br/>tentative running GWA, activity scores,<br/>join code / request status" --> P3(("3.0<br/>My Grades"))
  P3 <-- "MR / TFR / SG, GWA" --> D12c@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }
  P3 <-- "recorded / released scores" --> D11c@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }
  P3 <-- "activity title, description" --> D10c@{ shape: lin-rect, label: "D10&nbsp; class_activities" }
  P3 <-- "active class code" --> D35c@{ shape: lin-rect, label: "D35&nbsp; class_room_join_codes" }
  P3 <-- "pending request,<br/>instructor decision" --> D36c@{ shape: lin-rect, label: "D36&nbsp; class_join_requests" }

  %% ---------- 4.0 ----------
  S4["Student"] <-- "counts, FDA warning" --> P4(("4.0<br/>My<br/>Attendance"))
  P4 <-- "attendance per subject" --> D15d@{ shape: lin-rect, label: "D15&nbsp; attendance_records" }

  %% ---------- 5.0 ----------
  S5["Student"] <-- "question / topic diagnostics,<br/>GWA and PL forecast / published plans,<br/>task decisions / acknowledgment, task reports" --> P5(("5.0<br/>Academic<br/>Support"))
  P5 <-- "activity metadata" --> D10e@{ shape: lin-rect, label: "D10&nbsp; class_activities" }
  P5 <-- "posted milestones" --> D12e@{ shape: lin-rect, label: "D12&nbsp; posted_grades" }
  P5 <-- "recorded scores" --> D11e@{ shape: lin-rect, label: "D11&nbsp; student_activity_scores" }
  P5 -- "advisory log" --> D20e@{ shape: lin-rect, label: "D20&nbsp; student_academic_insights" }
  P5 <-- "published plan, acknowledgment,<br/>reported and verified tasks" --> D16e@{ shape: lin-rect, label: "D16&nbsp; student_risk_evaluations" }
  P5 <-- "grounded prompt / JSON diagnostics" --> AIP["AI Model Provider<br/>(Gemini 2.5 Flash<br/>via OpenRouter)"]

  %% ---------- 6.0 ----------
  S6["Student"] <-- "consultation request /<br/>response and status" --> P6(("6.0<br/>Consultations"))
  P6 <-- "booking record" --> D23f@{ shape: lin-rect, label: "D23&nbsp; student_consultation_requests" }

  %% ---------- 7.0 ----------
  S7["Student"] <-- "photo, contact number, guardian,<br/>password, alert choices / profile" --> P7(("7.0<br/>Account"))
  P7 <-- "contact number, photo reference" --> D1g@{ shape: lin-rect, label: "D1&nbsp; users" }
  P7 <-- "profile photo file" --> D30g@{ shape: lin-rect, label: "D30&nbsp; avatars (private storage)" }
  P7 <-- "primary guardian contact" --> D28g@{ shape: lin-rect, label: "D28&nbsp; guardians" }
  P7 <-- "device and email choices" --> D29g@{ shape: lin-rect, label: "D29&nbsp; notification_preferences" }
